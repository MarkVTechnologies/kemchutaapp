# ─────────────────────────────────────────────────────────────────
# KHL Mobile App — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────────────────────────

# Your existing KHL backend API URL
# Development: http://localhost:5000
# Staging:     https://staging-api.kemchutahomesltd.com
# Production:  https://api.kemchutahomesltd.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Expo project ID (from: npx eas init)
EXPO_PUBLIC_EAS_PROJECT_ID=your-project-id-here

# Sentry DSN for crash reporting (optional in dev)
EXPO_PUBLIC_SENTRY_DSN=

# Mixpanel token for analytics (optional in dev)
EXPO_PUBLIC_MIXPANEL_TOKEN=
