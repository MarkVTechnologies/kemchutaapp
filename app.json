{
  "expo": {
    "name": "Kemchuta Homes",
    "slug": "khl-mobile",
    "version": "1.0.6",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "khlmobile",
    "userInterfaceStyle": "light",
    "primaryColor": "#700CEB",
    "privacy": "unlisted",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#700CEB"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kemchutahomes.mobile",
      "buildNumber": "1",
      "requireFullScreen": true,
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSCameraUsageDescription": "To upload your profile photo and KYC documents",
        "NSPhotoLibraryUsageDescription": "To select images for your profile and documents",
        "NSPhotoLibraryAddUsageDescription": "To save documents to your photo library",
        "NSFaceIDUsageDescription": "To securely access your account without typing your password",
        "NSUserNotificationsUsageDescription": "To notify you about commission updates, payment confirmations, and inspection reminders",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:kemchutahomesltd.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#700CEB"
      },
      "package": "com.kemchutahomes.mobile",
      "versionCode": 7,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kemchutahomesltd.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kemchuta Homes to use Face ID for secure login"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#700CEB",
          "defaultChannel": "khl-alerts"
        }
      ],
      "expo-asset",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#700CEB" },
              "colorControlActivated": { "light": "#700CEB" }
            }
          }
        }
      ],
      "expo-web-browser",
      "react-native-edge-to-edge",
      "./plugins/withReleaseSigning",
      "./plugins/withGradleMemory"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6d8bdc10-0410-4065-8ef7-31538d4dacf4"
      },
      "privacyPolicyUrl": "https://kemchutahomesltd.com/privacy",
      "supportEmail": "support@kemchutahomesltd.com",
      "router": {}
    },
    "owner": "inspirememedia"
  }
}
